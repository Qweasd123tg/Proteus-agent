{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proteus",
  "version": "0.1.0",
  "identifier": "dev.proteus.agent",
  "build": {
    "beforeDevCommand": "node scripts/dev.mjs",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "node scripts/prepare.mjs --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "category": "DeveloperTool",
    "shortDescription": "Локальный модульный AI-агент",
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "resources/bin/": "bin/",
      "resources/configs/": "configs/"
    }
  }
}
