{
  "profile": {
    "name": "dev"
  },
  "active_provider": "anthropic",
  "providers": {
    "anthropic": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-20250514",
      "stream": true,
      "provider_config": {
        "api_key": "sk-ant-...",
        "base_url": "https://api.anthropic.com",
        "auth": "x-api-key",
        "api_version": "2023-06-01"
      }
    },
    "openai": {
      "provider": "openai",
      "model": "gpt-4.1",
      "stream": true,
      "provider_config": {
        "api_key": "sk-...",
        "base_url": "https://api.openai.com/v1"
      }
    },
    "local": {
      "provider": "openai_compatible",
      "model": "local-model-name",
      "stream": true,
      "provider_config": {
        "api_key": "not-needed",
        "base_url": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "modules": {
    "workflow": "coding.plan_execute_review",
    "context": "simple",
    "policy": "ask_write",
    "compactor": "codex",
    "subagent": "sequential",
    "renderer": "statusline"
  },
  "process_modules": [
    {
      "slot": "workflow",
      "module_id": "coding.plan_execute_review",
      "command": "proteus-reference-worker"
    },
    {
      "slot": "context",
      "module_id": "simple",
      "command": "proteus-reference-worker"
    },
    {
      "slot": "policy",
      "module_id": "ask_write",
      "command": "proteus-reference-worker"
    },
    {
      "slot": "compactor",
      "module_id": "codex",
      "command": "proteus-reference-worker"
    },
    {
      "slot": "renderer",
      "module_id": "statusline",
      "command": "proteus-reference-worker"
    }
  ],
  "subagents": {
    "surface": "task"
  },
  "module_config": {
    "policy": {
      "ask_write": {
        "ask_before": ["apply_patch", "remember_fact"],
        "allow": ["search", "request_user_input"]
      }
    },
    "context": {
      "simple": {
        "max_search_results": 50
      }
    }
  },
  "tools": {
    "enabled": ["apply_patch", "remember_fact", "request_user_input", "search"],
    "path": null
  },
  "permissions": {
    "mode": "normal"
  },
  "app_server": {
    "approval_timeout_ms": 0
  },
  "runtime": {
    "model_timeout_ms": 10800000,
    "context_timeout_ms": 30000,
    "workflow_timeout_ms": 14400000
  },
  "event_log": {
    "path": ".proteus/events.jsonl"
  }
}
